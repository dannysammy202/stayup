relatedThemes":["memories","perspective"]},{"id":"SM-000085","text":"Is there an everyday phrase you associate with one particular person?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["language","nostalgia"]},{"id":"SM-000086","text":"Tell me about a new friendship that started with a disagreement over something completely harmless.","topic":"Relationships","format":"Story starter","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["first meetings","differences"]},{"id":"SM-000087","text":"Running into someone by chance or setting a date for a proper catch-up?","topic":"Relationships","format":"Quick choice","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["spontaneity","reconnecting"]},{"id":"SM-000088","text":"A shared charger has saved more hangouts than anyone admits. What's the one item your friends always borrow?","topic":"Relationships","format":"Casual observation","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["practical help","group habits"]},{"id":"SM-000089","text":"What small courtesy do you notice straight away when meeting someone?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["manners","first impressions"]},{"id":"SM-000090","text":"Choosing the music on a road trip is a relationship responsibility, not a privilege. Who gets the aux?","topic":"Relationships","format":"Hot take","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["road trips","music"]},{"id":"SM-000091","text":"Someone remembers a joke you made months ago and brings it up at exactly the right moment. How do you react?","topic":"Relationships","format":"Scenario","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["memory","inside jokes"]},{"id":"SM-000092","text":"What's something people in your circle enjoy doing together even though none of you is particularly good at it?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["shared hobbies","fun"]},{"id":"SM-000093","text":"How did a simple introduction once create an unexpected connection between people you know?","topic":"Relationships","format":"Story starter","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["introductions","social circles"]},{"id":"SM-000094","text":"A quick 'thinking of you' text or a call with no particular reason?","topic":"Relationships","format":"Quick choice","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["check-ins","communication"]},{"id":"SM-000095","text":"People say 'We should do this again' at the end of every good outing. Who in your life makes sure it happens?","topic":"Relationships","format":"Casual observation","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["follow-through","planning"]},{"id":"SM-000096","text":"What's one thing you appreciate about people who make gatherings feel easy?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["hosting","social comfort"]},{"id":"SM-000097","text":"Remembering everyone's food allergies is a bigger act of care than choosing the fanciest venue. Agree?","topic":"Relationships","format":"Hot take","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["consideration","food"]},{"id":"SM-000098","text":"Your phone dies halfway through meeting up with someone, and you've agreed on a vague location. What's your backup plan?","topic":"Relationships","format":"Scenario","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["meeting up","technology"]},{"id":"SM-000099","text":"What has someone taught you to enjoy simply by being enthusiastic about it?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["enthusiasm","shared interests"]},{"id":"SM-000100","text":"Tell me about a photo of you with someone where the story behind it is better than the picture.","topic":"Relationships","format":"Story starter","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["photos","memories"]}]