mes":["shared experiences","closeness"]},{"id":"SM-000007","text":"Which shared joke has lasted far longer than it had any right to?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["humour","inside jokes"]},{"id":"SM-000008","text":"Someone you like spending time with is always twenty minutes early. Are you adjusting your schedule or letting them wait?","topic":"Relationships","format":"Scenario","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["timekeeping","habits"]},{"id":"SM-000009","text":"Remembering how someone takes their tea or coffee beats making a big speech. Agree?","topic":"Relationships","format":"Hot take","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["attention","thoughtfulness"]},{"id":"SM-000010","text":"What sort of message makes you smile before you even open it?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["texting","anticipation"]},{"id":"SM-000011","text":"Someone who picks the restaurant or someone who happily goes along with your pick?","topic":"Relationships","format":"Quick choice","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["planning","food"]},{"id":"SM-000012","text":"What's the most unexpected place you've made a lasting connection with someone?","topic":"Relationships","format":"Story starter","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["meeting people","shared spaces"]},{"id":"SM-000013","text":"The person who remembers everyone's order often becomes the unofficial organiser. Who plays that role in your circle?","topic":"Relationships","format":"Casual observation","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["group dynamics","food"]},{"id":"SM-000014","text":"What's an everyday routine you enjoy sharing with somebody else?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["routines","companionship"]},{"id":"SM-000015","text":"Being comfortable in silence deserves more credit than people give it. What's your view?","topic":"Relationships","format":"Hot take","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["comfort","quiet"]},{"id":"SM-000016","text":"You bump into an old friend at the supermarket with only five minutes to spare. What do you ask first?","topic":"Relationships","format":"Scenario","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["reconnecting","small talk"]},{"id":"SM-000017","text":"Which small tradition between you and another person would feel strange to stop?","topic":"Relationships","format":"Question","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["traditions","routines"]},{"id":"SM-000018","text":"Think of a plan that fell apart but turned into a surprisingly good day. Who were you with?","topic":"Relationships","format":"Story starter","moods":["Chill"],"audiences":["Anyone"],"angles":[],"adult":false,"editorialStatus":"approved","source":"published-library","relatedThemes":["spontaneity","memories"]},{"id":"SM-00